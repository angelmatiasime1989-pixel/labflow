NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
BACKUP_DIR=./backups
TRUST_PROXY=false
CUBOLABS_ADMIN_USERNAME=admin
CUBOLABS_ADMIN_NAME="Administrador del servicio"
# No hay contraseñas predeterminadas. Usa npm run setup o el archivo privado entregado.
CUBOLABS_ADMIN_FORCE_PASSWORD_CHANGE=false
CUBOLABS_ADMIN_PASSWORD=
BACKUP_ENCRYPTION_KEY=
# Opcionales, solo con claves reales de tu cuenta:
RESEND_API_KEY=
EMAIL_FROM=

# Optional: configure privately in the hosting secrets panel. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional public verification tag for Search Console; configure via hosting.
GOOGLE_SITE_VERIFICATION=

# AI usage ceilings per laboratory; configure according to the contracted scope.
QUBITO_TENANT_HOURLY_LIMIT=100
QUBITO_TENANT_MONTHLY_LIMIT=2000

# Keep path links until wildcard DNS, TLS and hosting routing have been verified.
TENANT_SUBDOMAINS_ENABLED=false

# Commercial requests stay disabled until business data/legal texts are confirmed in /admin.
SALES_ENABLED=false
# inbox = existing private CRM; resend = CRM plus accepted email notification.
SALES_CHANNEL=inbox
SALES_TO=

# Node-only isolated public trial. Never place this database in DATA_DIR, BACKUP_DIR or the code.
# Enable only after validating independent expiry maintenance outside deployment versions.
PUBLIC_TRIAL_ENABLED=false
PUBLIC_TRIAL_DB=

# Read-only encrypted offline documents; administrator must approve each user/device.
# Copies have no time-to-live; logout, account/lab changes and confirmed revocation remove them.
OFFLINE_DOCUMENTS_ENABLED=false

# MySQL: leave ALL DB_* empty for local SQLite. Any populated DB_* selects MySQL,
# and incomplete credentials/connection/schema fail startup (no local fallback).
# Set actual values only in Hostinger's private environment panel.
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# Optional absolute path to a trusted CA certificate; verifies server identity.
DB_SSL_CA=
# MySQL server must allow max_allowed_packet >= 67108864 (64 MiB).

# Stripe TEST integration only. Requires an isolated test database, all test values below,
# and NODE_ENV other than production. Live keys and production mode are rejected.
STRIPE_ENABLED=false
STRIPE_TEST_MODE=false
STRIPE_PORTAL_CONFIGURATION=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SILVER_MONTHLY=
STRIPE_PRICE_SILVER_ANNUAL=
STRIPE_PRICE_GOLD_MONTHLY=
STRIPE_PRICE_GOLD_ANNUAL=
STRIPE_PRICE_PLATINUM_MONTHLY=
STRIPE_PRICE_PLATINUM_ANNUAL=
STRIPE_PRICE_DIAMOND_MONTHLY=
STRIPE_PRICE_DIAMOND_ANNUAL=
# Enterprise Custom remains quotation-only. See docs/stripe.md before implementation.
