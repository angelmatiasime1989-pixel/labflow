# Plantilla para VPS: revisar rutas, destino Node y certificado ANTES de habilitar.
# El certificado debe cubrir qubolabs.tech y *.qubolabs.tech.
server {
    listen 443 ssl;
    server_name qubolabs.tech *.qubolabs.tech;
    ssl_certificate /etc/letsencrypt/live/qubolabs.tech/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/qubolabs.tech/privkey.pem;
    client_max_body_size 50m;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 120s;
    }
}
server {
    listen 80;
    server_name qubolabs.tech *.qubolabs.tech;
    return 301 https://$host$request_uri;
}
