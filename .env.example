NODE_ENV=development
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000
DATA_DIR=./data
BACKUP_DIR=./backups
TRUST_PROXY=false
CUBOLABS_ADMIN_USERNAME=admin
CUBOLABS_ADMIN_NAME="Administrador del servicio"
# No hay contraseñas predeterminadas. Usa npm run setup o el archivo privado entregado.
CUBOLABS_ADMIN_FORCE_PASSWORD_CHANGE=false
CUBOLABS_ADMIN_PASSWORD=
BACKUP_ENCRYPTION_KEY=
# Opcionales, solo con claves reales de tu cuenta:
RESEND_API_KEY=
EMAIL_FROM=

# Optional: configure privately in the hosting secrets panel. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional public verification tag for Search Console; configure via hosting.
GOOGLE_SITE_VERIFICATION=

# AI usage ceilings per laboratory; configure according to the contracted scope.
QUBITO_TENANT_HOURLY_LIMIT=100
QUBITO_TENANT_MONTHLY_LIMIT=2000

# Keep path links until wildcard DNS, TLS and hosting routing have been verified.
TENANT_SUBDOMAINS_ENABLED=false

# Production requires absolute DATA_DIR/BACKUP_DIR outside the deployment folder.
# Existing databases must be migrated before enabling the production startup guard.
BACKUP_AUTO_ENABLED=
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=30
BACKUP_REMOTE_REQUIRED=false
BACKUP_REMOTE_PREFIX=qubolabs-backups
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Use mysql only after migrating and verifying the existing SQLite database.
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSL=false
DB_SSL_CA=
