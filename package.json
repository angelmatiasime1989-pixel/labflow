{
  "name": "cubolabs-saas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-portable.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/audit-tests.mjs && node scripts/standalone-test.mjs && node --test scripts/landing-experience-test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "test:standalone": "node scripts/standalone-test.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs"
  },
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "pdf-lib": "1.17.1",
    "jszip": "3.10.1"
  }
}
