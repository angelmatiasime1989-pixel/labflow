{
  "name": "labflow-saas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "start": "node labflow-saas/vps/server.mjs",
    "build": "node labflow-saas/scripts/build-node.mjs",
    "test": "npm --prefix labflow-saas test && npm run test:demo",
    "check:hosting": "node labflow-saas/scripts/check-hosting.mjs",
    "start:demo": "node labflow-saas/vps/demo.mjs",
    "test:demo": "node --test labflow-saas/scripts/demo-test.mjs",
    "start:production": "node labflow-saas/vps/server.mjs",
    "dev": "node labflow-saas/vps/server.mjs"
  }
}
