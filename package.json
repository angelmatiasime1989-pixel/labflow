{
  "name": "cubolabs-saas",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-portable.mjs",
    "validate": "node scripts/validate-artifact.mjs",
    "dev": "node scripts/dev.mjs",
    "test": "node scripts/audit-tests.mjs && node scripts/standalone-test.mjs && node --test scripts/landing-experience-test.mjs scripts/first-login-test.mjs scripts/saas-release-test.mjs scripts/commercial-trial-test.mjs scripts/offline-documents-test.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "setup": "node --env-file-if-exists=.env scripts/setup.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "trial:cleanup": "node --env-file-if-exists=.env scripts/cleanup-public-trials.mjs",
    "test:pwa-browser": "node scripts/pwa-browser-test.mjs",
    "test:standalone": "node scripts/standalone-test.mjs",
    "restore": "node --env-file-if-exists=.env scripts/restore.mjs",
    "sync:hostinger": "node scripts/sync-hostinger.mjs",
    "check:hostinger-source": "node scripts/sync-hostinger.mjs --check",
    "test:mysql": "node --test scripts/mysql-safety-test.mjs && node scripts/mysql-integration-test.mjs && node scripts/mysql-flows-test.mjs"
  },
  "version": "1.0.0",
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1"
  },
  "dependencies": {
    "mysql2": "3.24.6"
  }
}
